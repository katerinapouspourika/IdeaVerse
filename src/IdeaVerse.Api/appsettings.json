{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "IdeaVerse": ""
  },
  "Database": {
    "MigrateOnStartup": false
  },
  "Reminders": {
    "Enabled": true,
    "Interval": "01:00:00"
  },
  "Email": {
    "From": "IdeaVerse <no-reply@ideaverse.local>",
    "SmtpHost": "",
    "SmtpPort": 587,
    "RequireTls": false,
    "Username": "",
    "Password": ""
  },
  "App": {
    "PublicUrl": "http://localhost:8080"
  },
  "Auth": {
    "RequireConfirmedEmail": true
  },
  "Contact": {
    "Recipient": "",
    "MessagesPerHour": 5
  },
  "Ai": {
    "Enabled": true,
    "DailyLimitPerWorkspace": 50
  },
  "Ideation": {
    "Effort": "medium",
    "IdeaCount": 5
  }
}
